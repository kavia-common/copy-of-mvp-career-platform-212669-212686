{
  "name": "simple-db-viewer",
  "version": "1.0.0",
  "description": "Simple database viewer for PostgreSQL, MySQL, SQLite, and MongoDB",
  "main": "server.js",
  "scripts": {
    "start": "node server.js --host 0.0.0.0",
    "dev": "nodemon server.js",
    "reinstall": "node -e \"try{require('fs').renameSync('node_modules','node_modules.bak')}catch(e){}; try{require('fs').renameSync('package-lock.json','package-lock.json.bak')}catch(e){}\" && npm install --no-audit --no-fund"
  },
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.11.3",
    "mysql2": "^3.6.3",
    "sqlite3": "^5.1.6",
    "mongodb": "^6.2.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}